# Copy to .env (or run `npm run setup:environment`). Examples only, never live credentials.
# Local process: shared Mongo's host-bound address. Docker Compose uses DB_URI_DOCKER.
DB_URI=mongodb://ellma:replace-with-database-password@127.0.0.1:27017/ellma?authSource=ellma
DB_URI_DOCKER=mongodb://ellma:replace-with-database-password@shared-mongo:27017/ellma?authSource=ellma
DB_ENGINE=mongodb
DBNAME=ellma
JWT_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_USER=admin@yappai.de
INITIAL_ADMIN_PASS=replace-with-a-strong-password
PORT=4000
# Browser origins allowed to call the API (comma separated).
ALLOWED_ORIGINS=https://ellma.yappai.de,http://localhost:5180,http://127.0.0.1:5180
# Open-weight model via Ollama. Host dev uses the published port; containers use dev-proxy.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_URL_DOCKER=http://ollama:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_KEEP_ALIVE=30m
# Public addresses used for the production build.
ELLMA_WEB_URL=https://ellma.yappai.de
ELLMA_API_URL=https://ellma-api.yappai.de
VITE_API_URL=http://localhost:4000
# The internal Verdaccio registry provides the current Yappio packages.
NPM_REGISTRY=http://192.168.178.131:4873/
